{
  "name": "lims-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Livestock Insurance Management System - REST API (Node.js + Express + MySQL + Firebase Auth)",
  "main": "src/server.js",
  "scripts": {
    "dev": "node scripts/free-port.js && nodemon --watch src --ext js --exec \"node src/server.js\"",
    "start": "node scripts/free-port.js && node src/server.js",
    "lan": "node scripts/write-api-json.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "firebase-admin": "^12.3.1",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18"
  }
}
